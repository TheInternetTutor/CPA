# Cash App Portfolio Analysis (CPA)
# Keep source code, required configuration, documentation, and tests in Git.
# Ignore only local clutter, secrets, caches, and reproducible generated output.

# ----------------------------------------------------------------------
# Operating-system clutter
# ----------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ----------------------------------------------------------------------
# Editors and IDEs (personal workspace state)
# ----------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ----------------------------------------------------------------------
# Local environment and credentials
# ----------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
id_rsa
id_ed25519
credentials.json
secrets.json
.credentials/

# ----------------------------------------------------------------------
# Logs, temporary files, and backups
# ----------------------------------------------------------------------
# *.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.stackdump

# ----------------------------------------------------------------------
# Runtime caches and test/coverage artifacts
# ----------------------------------------------------------------------
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/

# ----------------------------------------------------------------------
# Build and packaging output (include these only if reproducible)
# ----------------------------------------------------------------------
build/
dist/
out/
*.egg-info/

# ----------------------------------------------------------------------
# Dependency directories
# ----------------------------------------------------------------------
node_modules/
.venv/
venv/
env/

# ----------------------------------------------------------------------
# Local-only exports and generated data
# NOTE: Do not ignore *.csv, *.json, or broad data/ directories globally.
# Add specific generated paths here after confirming they are reproducible
# and are not required source fixtures or intentional project assets.
# ----------------------------------------------------------------------
